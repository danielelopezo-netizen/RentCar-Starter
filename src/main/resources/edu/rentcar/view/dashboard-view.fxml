<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.rentcar.controller.DashboardController" spacing="18">
    <Label text="Welcome to RentCar" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Manage the vehicle fleet, rental modalities, service packages, customer verification and payment integration." wrapText="true"/>
    <HBox spacing="16">
        <VBox spacing="8" prefWidth="210" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="Sample customers"/>
            <Label fx:id="customerCountLabel" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #172b4d;"/>
        </VBox>
        <VBox spacing="8" prefWidth="210" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="Registered vehicles"/>
            <Label fx:id="vehicleCountLabel" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #172b4d;"/>
        </VBox>
        <VBox spacing="8" prefWidth="210" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="Confirmed rentals"/>
            <Label fx:id="confirmedCountLabel" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
        </VBox>
    </HBox>
    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8;">
        <Label text="System overview" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label text="• Vehicles &amp; Customers: Browse sample customers (authorized and unauthorized) and register new fleet vehicles." wrapText="true"/>
        <Label text="• Reservations: Build rental requests (Builder), select modalities (Abstract Factory), add optional services (Decorator) and nested packages (Composite)." wrapText="true"/>
        <Label text="• Verification &amp; Payments: Every rental is coordinated by RentalFacade, verified by VerifiedPaymentProxy, and sent to the external payment API via PaymentAdapter." wrapText="true"/>
    </VBox>
</VBox>
